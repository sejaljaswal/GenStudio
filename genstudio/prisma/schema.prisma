generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Generation {
  id             String   @id @default(cuid())
  prompt         String
  negativePrompt String?
  width          Int?
  height         Int?
  steps          Int?
  seed           Int?
  status         String   @default("pending")
  imageUrl       String?
  falRequestId   String?
  errorMessage   String?
  completedAt    DateTime?
  parentId       String?
  parent         Generation?  @relation("GenerationToGeneration", fields: [parentId], references: [id])
  children       Generation[] @relation("GenerationToGeneration")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
